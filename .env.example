# Copy to .env and fill in. Never commit the real .env file.

# --- Network (docker compose) ---
# Localhost only by default; 0.0.0.0 makes the UI reachable from the LAN.
# Never expose cve_detector to the Internet.
# CVED_BIND_ADDRESS=127.0.0.1
# CVED_PORT=8080

# --- Web UI admin account (required) ---
CVED_ADMIN_USERNAME=admin
# Plain text, or better an argon2 hash printed by `python -m cve_detector.hash_password`
# (keep the single quotes around a hash so that "$" is not interpreted).
CVED_ADMIN_PASSWORD=change-me
# CVED_SESSION_DAYS=7
# Only send the session cookie over HTTPS (enable behind a TLS reverse proxy)
# CVED_COOKIE_SECURE=false

# --- SMTP (example: Gmail with an App Password) ---
CVED_SMTP_HOST=smtp.example.com
CVED_SMTP_PORT=587
CVED_SMTP_SECURITY=starttls   # starttls | ssl | none
CVED_SMTP_USERNAME=alerts@example.com
CVED_SMTP_PASSWORD=change-me
CVED_SMTP_FROM="cve_detector <alerts@example.com>"
# CVED_SMTP_TIMEOUT_SECONDS=30
# Optional: told when scans start failing and when they recover
# CVED_ADMIN_EMAIL=admin@example.com

# --- Vulnerability source (defaults are fine) ---
# CVED_OSV_API_URL=https://api.osv.dev
# CVED_HTTP_TIMEOUT_SECONDS=30
# CVED_OSV_MAX_WORKERS=4

# --- Scheduler (defaults are fine) ---
# CVED_SCAN_TICK_SECONDS=300
# CVED_SCAN_RETRY_MINUTES=60
# CVED_SUPPRESSION_EXPIRY_WARNING_DAYS=7
